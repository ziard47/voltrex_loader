{
  "name": "voltrex-downloader",
  "version": "1.0.1",
  "description": "High-performance cross-platform Download Manager using Electron, React, MUI, and Tailwind",
  "main": "src/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "cross-env VITE_DEV=true electron .",
    "dev": "concurrently -k -s first \"npm run dev:vite\" \"npm run dev:electron\"",
    "build": "vite build",
    "package:linux": "node scripts/package-linux.mjs",
    "package:win": "node scripts/package-win.mjs",
    "package:appimage": "npm run build && electron-builder --linux AppImage",
    "package:dir": "npm run build && electron-builder --linux dir",
    "install:desktop": "bash scripts/install-steamos-desktop.sh",
    "uninstall:desktop": "bash scripts/uninstall-steamos-desktop.sh",
    "start": "electron .",
    "test": "node -c src/main.js && node -c src/main/downloadEngine.js && node -c src/main/bridgeServer.js && node -c src/preload.js"
  },
  "build": {
    "appId": "com.voltrex.loader",
    "productName": "Voltrex Loader",
    "executableName": "voltrex-loader",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "src/main.js",
      "src/preload.js",
      "src/main/**/*",
      "src/assets/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "dir"
      ],
      "category": "Network",
      "icon": "build/icons",
      "synopsis": "High-Performance Download Manager",
      "description": "Voltrex Loader is a high-performance download accelerator featuring multi-chunk range streaming, auto-retry recovery, and browser extension capture."
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Voltrex Loader"
    }
  },
  "keywords": [
    "electron",
    "download-manager",
    "idm",
    "fdm",
    "material-ui",
    "tailwind"
  ],
  "author": "Mohomed Ziard | Voltrex Digital",
  "license": "MIT",
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^6.4.5",
    "@mui/material": "^6.4.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3",
    "lucide-react": "^0.475.0",
    "postcss": "^8.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.1"
  }
}
