{
  "manifest_version": 3,
  "name": "Voltrex Loader - Browser Integration",
  "version": "1.0.2",
  "description": "Seamlessly capture downloads and send links directly into the Voltrex Loader download accelerator.",
  "permissions": [
    "downloads",
    "contextMenus",
    "storage",
    "notifications"
  ],
  "host_permissions": [
    "http://127.0.0.1:9580/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Voltrex Loader Integration",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
